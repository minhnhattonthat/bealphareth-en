  },
  {
   "id": "RES#558:a5d2",
   "off": 42450,
   "len": 105,
   "bank": "0.1",
   "jp": "{1c:13}{0b:08}{e080} ジェシカ {e083}{0b:09}\nそんなことないよ。\n{e08f}に見直しちゃったよ。{1a}なあんだ、そんなこと考えてたんだ。\nいつも笑ってるから、\n何にも考えてないのかと思ってたよ。{0c:291b23080001fe}",
   "raw": null,
   "en": "",
   "status": "todo"
  },
