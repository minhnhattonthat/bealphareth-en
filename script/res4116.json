  },
  {
   "id": "RES#4116:9893",
   "off": 39059,
   "len": 44,
   "bank": "0.1",
   "jp": "{1c:11}{0b:08}{87ac} レイア {87ad}{0b:09}\n物乞いになったつもりはない。{0c:2b1f23080001fe}",
   "raw": null,
   "en": "",
   "status": "todo"
  },
  {
   "id": "RES#4116:98bf",
   "off": 39103,
   "len": 192,
   "bank": "0.1",
   "jp": "{0b:08}{87ac} アスロイト人A {87ad}{0b:09}\n気取ってんじゃねえよ。\n剣なんぞ持って\nまだ騎士様のつもりか?{1a}まったく、\n見苦しいったらありゃしねえぜ、\nいつまでも過去の{e089}光に\nしがみつきやがってよ。{1a}土地を持たねえ元貴族なんぞ\n物乞いも同じ、\nいや、現実を受け入れてる{8198}\n物乞いの方がまだマシだ。{0c:2b1e23080001fe}",
   "raw": null,
   "en": "",
   "status": "todo"
  },
  {
   "id": "RES#4116:997f",
   "off": 39295,
   "len": 16,
   "bank": "0.1",
   "jp": "{0c:2b1e23080001511810090c0ffe}",
