  {
   "id": "RES#4112:8fc4",
   "off": 36804,
   "len": 95,
   "bank": "0.1",
   "jp": "{0b:08}{e080} {03}アスロイト人{01}A {e081}{0b:09}\n{02}よう{e082}入り、どうした{01}?{1a}{02}・・・ん{01}?\n{02}お前{03}アスロイト{02}の人{8196}じゃねえな。\nどうした{01}? 何{02}しに来た{01}?{0c:2b2023080001fe}",
   "raw": null,
   "en": "",
   "status": "todo"
  },
  {
   "id": "RES#4112:9023",
   "off": 36899,
   "len": 9,
   "bank": "0.1",
   "jp": "{0c:2b20231007fe}",
   "raw": null,
