    {"box": [4, 52, 45, 67], "text": "I know!", "align": "center", "size": 12},
    {"box": [55, 52, 184, 67], "text": "Meet someone! This is...", "align": "center", "size": 12},
    {"box": [4, 68, 42, 83], "text": "Yeah.", "align": "center", "size": 12},
    {"box": [52, 68, 236, 83], "text": "I know. I dreamed of you so many times.", "align": "center", "size": 12},
    {"box": [4, 84, 226, 99], "text": "You're the one Big Brother loves most, right?", "align": "center", "size": 12},
    {"box": [4, 100, 148, 115], "text": "There's nothing out here, but...", "align": "center", "size": 12},
    {"box": [4, 116, 175, 131], "text": "I swear I'll make you happy.", "align": "center", "size": 12},
    {"box": [10, 226, 154, 238], "text": "A year, four months after the blast","align": "center", "size": 12},
