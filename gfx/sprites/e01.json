[
  {"sheet": "235+1f854.0", "blocks": [
    {"box": [4, 4, 86, 19], "text": "Big brother!", "align": "center", "size": 12},
    {"box": [88, 4, 142, 19], "text": "Hanna!", "align": "center", "size": 12},
    {"box": [144, 4, 185, 19], "text": "Yeah!", "align": "center", "size": 12},
    {"box": [4, 20, 116, 35], "text": "Your eyes are healed!", "align": "center", "size": 12},
    {"box": [116, 20, 238, 35], "text": "You're well again!", "align": "center", "size": 12},
    {"box": [4, 36, 63, 51], "text": "So glad...", "align": "center", "size": 12},
    {"box": [63, 36, 176, 51], "text": "I'm so, so glad...", "align": "center", "size": 12},
    {"box": [4, 52, 45, 67], "text": "I know!", "align": "center", "size": 12},
    {"box": [48, 52, 214, 67], "text": "Meet your big brother's friend.", "align": "center", "size": 12},
    {"box": [4, 68, 43, 82], "text": "Hanna.", "align": "center", "size": 12},
    {"box": [53, 68, 215, 83], "text": "This is who saved your life.", "align": "center", "size": 12},
    {"box": [4, 84, 45, 99], "text": "Huh...", "align": "center", "size": 12},
    {"box": [48, 84, 199, 99], "text": "Gone already, I guess...", "align": "center", "size": 12},
    {"box": [4, 100, 159, 116], "text": "Big brother... are you crying?", "align": "center", "size": 12},
    {"box": [4, 116, 40, 131], "text": "No.", "align": "center", "size": 12},
    {"box": [50, 116, 124, 131], "text": "I'm not crying.", "align": "center", "size": 12},
    {"box": [4, 132, 131, 147], "text": "However far apart we are,", "align": "center", "size": 12},
    {"box": [4, 148, 161, 163], "text": "we're still friends.", "align": "center", "size": 12},
    {"box": [10, 226, 154, 238], "text": "A year, four months after the blast","align": "center", "size": 12},
    {"box": [1, 241, 220, 253], "text": "A mountain in Belm County, northern former Asroit", "align": "center", "size": 12}
  ]},
