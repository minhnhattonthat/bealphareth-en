  {"sheet": "236+1caf0.0", "blocks": [
    {"box": [2, 226, 105, 237], "text": "Five years after the blast,", "align": "center", "size": 12},
    {"box": [2, 242, 152, 253], "text": "the eve of the Battle of Tintagel...", "align": "center", "size": 12}
  ]},
  {"sheet": "236+1d400.0", "blocks": [
    {"box": [2, 2, 243, 13], "text": "Its food burned, the thirteen-nation army faltered,", "align": "center", "size": 12},
    {"box": [3, 18, 134, 29], "text": "and Arthur Luitgard", "align": "center", "size": 12},
    {"box": [1, 33, 204, 45], "text": "broke it piecemeal in the forest of Tintagel.", "align": "center", "size": 12},
    {"box": [2, 50, 112, 62], "text": "The Battle of Tintagel", "align": "center", "size": 12},
    {"box": [2, 65, 161, 78], "text": "ended in a great Luitgard victory.", "align": "center", "size": 12},
    {"box": [2, 82, 122, 93], "text": "A few had routed a host,", "align": "center", "size": 12},
    {"box": [2, 97, 247, 109], "text": "Arthur Luitgard's fame rang across the north,", "align": "center", "size": 12},
    {"box": [3, 114, 138, 125], "text": "and many lords yielded.", "align": "center", "size": 12},
    {"box": [3, 129, 242, 141], "text": "Then, without once invading another nation's lands,", "align": "center", "size": 12},
    {"box": [3, 145, 216, 157], "text": "he founded the north's largest realm, Graston.", "align": "center", "size": 12},
    {"box": [3, 162, 90, 173], "text": "Graston", "align": "center", "size": 12},
    {"box": [3, 177, 194, 190], "text": "went on to face many foreign attacks,", "align": "center", "size": 12},
    {"box": [3, 193, 149, 205], "text": "yet was never once defeated.", "align": "center", "size": 12},
    {"box": [2, 210, 194, 221], "text": "On every field stood the king's best friend.", "align": "center", "size": 12},
    {"box": [2, 226, 170, 237], "text": "In his old age, King Arthur recalled:", "align": "center", "size": 12},
    {"box": [5, 241, 184, 254], "text": "\"He was the true hero...\"", "align": "center", "size": 12}
  ]},
  {"sheet": "236+21e30.0", "blocks": [
    {"box": [4, 2, 117, 13], "text": "Now the king's sword,", "align": "center", "size": 12},
    {"box": [4, 17, 195, 29], "text": "now his shield, she fought so well that", "align": "center", "size": 12},
    {"box": [3, 33, 193, 45], "text": "people named her Valkyrie, goddess of war.", "align": "center", "size": 12},
    {"box": [7, 49, 223, 62], "text": "\"She was the best of wives to me,", "align": "center", "size": 12},
    {"box": [4, 65, 136, 78], "text": "and best of comrades...\"", "align": "center", "size": 12},
    {"box": [2, 81, 184, 94], "text": "On every field stood the king's wife.", "align": "center", "size": 12},
    {"box": [2, 226, 170, 237], "text": "In his old age, King Arthur recalled:", "align": "center", "size": 12},
    {"box": [6, 241, 185, 254], "text": "\"He was the true hero...\"", "align": "center", "size": 12}
  ]},
  {"sheet": "237+300ac.0", "blocks": [
    {"box": [1, 242, 130, 253], "text": "Four years after the blast...", "align": "center", "size": 12}
  ]},
  {"sheet": "237+3079c.0", "blocks": [
    {"box": [1, 2, 198, 13], "text": "Two days later, reunited with her mother,", "align": "center", "size": 12},
    {"box": [1, 18, 137, 29], "text": "she wept ten years of tears.", "align": "center", "size": 12},
    {"box": [2, 34, 170, 45], "text": "And then, four years after the blast...", "align": "center", "size": 12},
    {"box": [1, 50, 209, 61], "text": "the two mercenaries famed across the world", "align": "center", "size": 12},
    {"box": [2, 66, 192, 77], "text": "were, they say, never seen after that day.", "align": "center", "size": 12},
    {"box": [1, 82, 93, 93], "text": "She laid down arms.", "align": "center", "size": 12},
    {"box": [1, 98, 177, 109], "text": "With her mother, brother and husband,", "align": "center", "size": 12},
    {"box": [2, 113, 199, 125], "text": "she built a hospital for those wounded in war", "align": "center", "size": 12},
    {"box": [2, 130, 236, 141], "text": "at Herda, Asroit's bloodiest battlefield, it is said.", "align": "center", "size": 12},
    {"box": [1, 146, 121, 157], "text": "Clumsy though she was,", "align": "center", "size": 12},
    {"box": [1, 161, 148, 173], "text": "she gave herself to the wounded,", "align": "center", "size": 12},
    {"box": [3, 178, 189, 189], "text": "giving her life to the sick and the poor,", "align": "center", "size": 12},
    {"box": [3, 194, 152, 205], "text": "like the patron saint Leia...", "align": "center", "size": 12}
  ]},
