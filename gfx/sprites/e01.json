  {"sheet": "238+4c348.0", "blocks": [
    {"box": [3, 2, 50, 13], "text": "There", "align": "center", "size": 12},
    {"box": [3, 18, 210, 29], "text": "was the ideal Eleanor, Wise Woman of the West,", "align": "center", "size": 12},
    {"box": [2, 34, 130, 45], "text": "dreamed of in her youth...", "align": "center", "size": 12},
    {"box": [2, 66, 122, 78], "text": "Victors in many battles,", "align": "center", "size": 12},
    {"box": [14, 81, 188, 94], "text": "the War God and Wise Woman of the West", "align": "center", "size": 12},
    {"box": [1, 98, 83, 110], "text": "rang worldwide.", "align": "center", "size": 12},
    {"box": [85, 98, 198, 110], "text": "was truly their home.", "align": "center", "size": 12},
    {"box": [0, 114, 250, 125], "text": "Mercenaries devoted to them gathered at their side,", "align": "center", "size": 12},
    {"box": [2, 130, 214, 141], "text": "and in time the world's mightiest band arose.", "align": "center", "size": 12},
    {"box": [2, 146, 156, 158], "text": "In one battle, their band", "align": "center", "size": 12},
    {"box": [167, 146, 214, 157], "text": "That castle", "align": "center", "size": 12},
    {"box": [2, 162, 205, 174], "text": "won a ruined castle in place of a reward.", "align": "center", "size": 12},
    {"box": [2, 178, 255, 189], "text": "to mercenaries with no home or family awaiting them,", "align": "center", "size": 12},
    {"box": [3, 194, 189, 205], "text": "Small, yet a place where all could live", "align": "center", "size": 12},
    {"box": [1, 210, 162, 221], "text": "with a smile, a land at peace...", "align": "center", "size": 12}
  ]},
