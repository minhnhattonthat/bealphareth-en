 {"box": [33, 133, 300, 148], "ink": "light", "text": "Tap: sets a trap right in front of the character.", "size": 14},
 {"box": [33, 151, 300, 168], "ink": "light", "text": "Hold + D-pad: sets it wherever you choose.", "size": 14},
 {"box": [12, 200, 300, 216], "ink": "light", "text": "Up to 8 traps can be set at one time."},
 {"box": [12, 228, 300, 265], "ink": "light", "text": "The traps you can set are shown in the \"Trap/Magic Select Menu\" at the top left of the screen."},
 {"box": [12, 283, 300, 320], "ink": "light", "text": "Traps currently set are shown in the \"Set Traps Window\" at the top right of the screen."},
 {"box": [12, 348, 300, 382], "ink": "light", "text": "Have a \"Trap Capsule\" upgraded at Qumran's house and you can use new traps."},
