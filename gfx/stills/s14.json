{"entry": 3970, "blocks": [
 {"box": [113, 46, 195, 74], "ink": "light", "text": "Direct Attack", "align": "center", "bold": true, "size": 18},
 {"box": [55, 107, 150, 125], "ink": "light", "text": "Direct Attack", "bold": true},
 {"box": [72, 133, 295, 190], "ink": "light", "text": "A direct attack with your weapon. Its reach differs from weapon to weapon. There are 9 weapon types in all."},
 {"box": [50, 192, 305, 236], "ink": "light", "text": "One-Handed Sword, Two-Handed Sword (Axe, Battleaxe), Rapier (Parrier), Bow (Crossbow), Spear (Halberd), Dagger, Staff, Sacred Staff, Tablet", "size": 12},
 {"box": [72, 272, 295, 306], "ink": "light", "text": "- Use knockback and you can defeat enemies without taking damage!"},
 {"box": [72, 322, 295, 378], "ink": "light", "text": "- Use knockback to defeat many enemies at once and you earn more money than by defeating them one at a time."},
 {"box": [50, 402, 270, 418], "ink": "light", "text": "START: back to the \"Controls\" screen", "size": 14}
]},

{"entry": 3971, "blocks": [
 {"box": [106, 46, 197, 74], "ink": "light", "text": "Talk / Examine / Cancel", "align": "center", "bold": true, "size": 18},
 {"box": [15, 85, 120, 105], "ink": "light", "text": "Talk / Examine", "bold": true},
 {"box": [30, 115, 305, 192], "ink": "light", "text": "You can talk with your companions and the townsfolk, and examine things. (With \"Bump to Talk\" under \"System\" in the Main Menu set to \"On\", the D-pad alone lets you talk and examine.)", "size": 14},
 {"box": [30, 194, 300, 209], "ink": "light", "text": "If text is being skipped with START, hold", "size": 14},
 {"box": [48, 218, 300, 233], "ink": "light", "text": "to end the skip.", "size": 14},
 {"box": [15, 240, 110, 258], "ink": "light", "text": "Remove Trap", "bold": true},
 {"box": [58, 272, 305, 287], "ink": "light", "text": "held + D-pad: select a trap.", "size": 14},
 {"box": [32, 298, 132, 313], "ink": "light", "text": "Then press", "size": 14},
 {"box": [158, 298, 305, 313], "ink": "light", "text": "to remove it.", "size": 14},
 {"box": [15, 340, 80, 358], "ink": "light", "text": "Turn", "bold": true},
 {"box": [48, 365, 305, 380], "ink": "light", "text": "held + D-pad: turn your character", "size": 14},
 {"box": [30, 389, 305, 420], "ink": "light", "text": "to face a new way without moving from the spot.", "size": 14},
 {"box": [50, 433, 270, 449], "ink": "light", "text": "START: back to the \"Controls\" screen", "size": 14}
], "erase": [{"box": [32, 319, 190, 332], "ink": "light"}]},

{"entry": 3972, "blocks": [
 {"box": [108, 46, 197, 74], "ink": "light", "text": "Set Trap / Cast Spell", "align": "center", "bold": true, "size": 18},
